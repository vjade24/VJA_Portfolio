<!DOCTYPE html><html lang="en" data-theme="dark"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content="Full-Stack Software Developer specializing in Laravel, ASP.NET, SQL Server, MySQL, business process automation, government information systems, and enterprise applications."/>
<meta name="theme-color" content="#07101d"/><meta property="og:title" content="Vincent Jade | Full-Stack Software Developer"/><meta property="og:description" content="I build information systems that solve real organizational problems, automate workflows, and improve day-to-day operations."/><meta property="og:type" content="website"/>
<title>@ViewData["Title"]</title><link rel="icon" href="~/images/favicon.svg" type="image/svg+xml"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<a class="skip-link" href="#main-content">Skip to content</a><header class="site-header"><div class="container nav-wrap"><a class="brand" href="#home"><span class="brand-mark">VJ</span><span>Vincent Jade</span></a><nav class="nav-links" data-nav aria-label="Main navigation"><a class="nav-link active" href="#home">Home</a><a class="nav-link" href="#about">About</a><a class="nav-link" href="#skills">Skills</a><a class="nav-link" href="#projects">Projects</a><a class="nav-link" href="#experience">Experience</a><a class="nav-link" href="#services">Services</a><a class="nav-link" href="#contact">Contact</a></nav><div class="nav-actions"><button class="icon-button" data-theme-toggle aria-label="Switch theme"><span>☀</span></button><button class="menu-button" data-menu-toggle aria-label="Open navigation" aria-expanded="false">Menu</button></div></div></header>
<main id="main-content">@RenderBody()</main><footer class="site-footer"><div class="container footer-wrap"><span>© <span data-year></span> Vincent Jade. Built with ASP.NET Core.</span><span>Business systems · Automation · Reliable software</span></div></footer><button class="back-top" data-back-top aria-label="Back to top">↑</button><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>

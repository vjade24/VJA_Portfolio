<section class="hero" id="home"><div class="container hero-grid"><div data-reveal><span class="availability"><i></i> Full-stack systems developer</span><h1>Vincent <span>Jade.</span></h1><div class="hero-role">Full-Stack Software Developer</div><p class="hero-copy">I design and develop reliable, maintainable, and user-friendly information systems that automate business processes and improve organizational workflows.</p><p class="hero-specialty">Specialized in business applications, government information systems, workflow automation, database development, reporting, and production deployment.</p><div class="button-row"><a class="btn btn-primary" href="#projects">View Projects ↓</a><a class="btn btn-ghost" href="#about">About Me</a><a class="btn btn-ghost" href="#contact">Contact Me</a><a class="btn btn-ghost" data-resume href="~/documents/resume.pdf" download>Download Resume</a></div></div><div class="terminal-wrap" data-reveal><div class="terminal"><div class="terminal-bar"><i></i><i></i><i></i><span>system-builder.cs</span></div><pre class="terminal-code"><span class="code-key">public class</span> <span class="code-fn">Developer</span> {
 Name = <span class="code-string">"Vincent Jade"</span>;
 Focus = <span class="code-string">"Information Systems"</span>;
 Mission = <span class="code-string">"Simplify operations"</span>;
 Stack = [<span class="code-string">"Laravel"</span>, <span class="code-string">"ASP.NET"</span>, <span class="code-string">"SQL"</span>];
}</pre><div class="dashboard-mini"><div class="metric"><b>Full-stack</b><span>APPLICATION DELIVERY</span></div><div class="metric"><b>Database</b><span>DATA &amp; REPORTING</span></div><div class="metric"><b>Production</b><span>DEPLOY &amp; SUPPORT</span></div></div></div></div></div></section>

<section class="section section-alt" id="about"><div class="container about-grid"><aside class="about-panel" data-reveal><div class="monogram">VJ</div><h3>Vincent Jade</h3><p>Full-Stack Software Developer</p><div class="mini-list"><div><span>Focus</span>Business systems</div><div><span>Strength</span>Workflow automation</div><div><span>Delivery</span>Production-ready</div></div></aside><div class="about-copy" data-reveal><span class="eyebrow">About me</span><h2>I turn complex processes into practical digital systems.</h2><p>I am a software developer focused on transforming complex organizational processes into efficient digital solutions. My experience includes HR information systems, Point of Sale applications, employee training systems, PDL management, procurement document automation, reporting, and database-driven applications.</p><blockquote>I build information systems that solve real organizational problems, automate workflows, and improve day-to-day operations.</blockquote><div class="value-grid"><article class="value-card"><span class="icon">01</span><h3>Full-stack delivery</h3><p>System analysis, architecture, frontend, backend, testing, and deployment.</p></article><article class="value-card"><span class="icon">02</span><h3>Operational expertise</h3><p>Government workflows, business rules, reporting, and production support.</p></article><article class="value-card"><span class="icon">03</span><h3>Data-centered design</h3><p>Databases that support accurate transactions, reporting, and auditability.</p></article><article class="value-card"><span class="icon">04</span><h3>Legacy enhancement</h3><p>Improve working applications safely and troubleshoot production issues.</p></article></div></div></div></section>

<section class="section" id="skills"><div class="container"><div class="section-heading" data-reveal><span class="eyebrow">Technical capabilities</span><h2>Tools for complete application delivery.</h2><p>From data model and business rules to interface, reporting, deployment, and support.</p></div><div class="skills-grid">@foreach(var g in skills){<article class="skill-group" data-reveal><h3><span>//</span>@g.Item1</h3><div class="badges">@foreach(var s in g.Item2){<span class="badge">@s</span>}</div></article>}</div></div></section>

<section class="section section-alt" id="projects"><div class="container"><div class="projects-lead"><div class="section-heading" data-reveal><span class="eyebrow">Featured projects</span><h2>Systems built for real operations.</h2><p>Representative previews use dummy data and expose no confidential production information.</p></div><div class="filters"><button class="filter active" data-filter="all">All</button><button class="filter" data-filter="government">Government</button><button class="filter" data-filter="business">Business</button><button class="filter" data-filter="automation">Automation</button></div></div><div class="projects-grid">@for(var i=0;i<projects.Length;i++){var p=projects[i];<article class="project-card @(i==0?"featured-wide":"")" data-category="@p.filter" data-reveal><div class="project-visual"><div class="project-window" role="img" aria-label="Sanitized @p.title dashboard preview"><div class="window-bar"><i></i><i></i><i></i></div><div class="mock-body"><div class="mock-side"><b></b><span></span><span></span><span></span></div><div class="mock-content"><div class="mock-title"></div><div class="mock-metrics"><i></i><i></i><i></i></div><div class="mock-chart"></div></div></div></div></div><div class="project-content"><span class="project-number">0@(i+1) · @p.category</span><h3>@p.title</h3><p>@p.description</p><div class="project-problem"><b>Operational outcome:</b> @p.solution</div><div class="tech-row">@foreach(var t in p.tech.Split('|').Take(4)){<span>@t</span>}</div><div class="card-actions"><button class="text-link project-open" data-project="@p.id">View case study →</button><span class="private-label">Private / Internal System</span></div></div></article>}</div></div></section>

<section class="section" id="experience"><div class="container"><div class="section-heading" data-reveal><span class="eyebrow">Experience</span><h2>Software delivery across the full lifecycle.</h2></div><div class="timeline">@foreach(var e in new[]{("System delivery","Full-Stack Software Development","Analyze, design, build, test, and deploy database-driven applications."),("Operational domains","Government, HR, Procurement & Retail Systems","Build workflow-heavy systems for employee services, institutional records, procurement, sales, and inventory."),("Data and reporting","Database Development & Automated Reporting","Design schemas, write complex SQL, administer data, and generate PDF, Excel, Word, and Crystal Reports."),("Production","Deployment, Troubleshooting & Legacy Enhancement","Configure servers, enhance existing software, diagnose issues, maintain systems, and support users.")}){<article class="timeline-item" data-reveal><i class="timeline-dot"></i><small>@e.Item1</small><h3>@e.Item2</h3><p>@e.Item3</p></article>}</div></div></section>

